# Copy to frontend/.env, fill in, then rebuild:  npm --prefix frontend run build
# Publisher id from AdSense → Account → Account information
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Ad unit ids from AdSense → Ads → By ad unit → Display ads
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_REPORT=
VITE_ADSENSE_SLOT_PORTFOLIO=
